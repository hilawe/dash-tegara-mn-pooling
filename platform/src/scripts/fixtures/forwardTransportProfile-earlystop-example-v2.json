    "sweepAgainstAbsentEmpty": true,
    "planBuiltBeforeAnyRead": true,
    "planFiguresSource": "journaled-header",
    "planHeaderEqualsFormation": true,
    "selfShareDerived": true,
    "identifiersCanonical": true,
    "verdictOwner": "shared-verifier",
    "universe": [
      0,
      1
    ],
    "refreshCountMax": 3,
    "generationSequence": [
      0
    ],
    "earlyStop": {
      "afterGeneration": 0,
      "code": "REFUSED_EPOCH_IN_SNAPSHOT",
      "epochIndex": 0
    }
  },
  "optional": {}
